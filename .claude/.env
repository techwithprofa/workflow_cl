# Claude Multi-Agent System Environment Variables
# This file contains environment-specific configuration

# ============================================
# Appwrite Configuration (Backend as a Service)
# ============================================
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=

# ============================================
# Application Configuration
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Claude Multi-Agent System

# ============================================
# Database (if using separate database)
# ============================================
DATABASE_URL=

# ============================================
# Authentication (if using NextAuth or similar)
# ============================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# ============================================
# API Keys (External Services)
# ============================================

# Vercel (for deployments)
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Error Tracking (Sentry)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ANALYTICS=

# ============================================
# Feature Flags
# ============================================
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DEBUG=true
NEXT_PUBLIC_MAINTENANCE_MODE=false

# ============================================
# Email Service (if applicable)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourapp.com

# ============================================
# Storage (if using S3 or similar)
# ============================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# ============================================
# Payment Gateway (Stripe example)
# ============================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================
# Social Auth (OAuth providers)
# ============================================

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Twitter OAuth
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# ============================================
# Communication (Slack, Discord)
# ============================================

# Slack
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=

# Discord
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=

# ============================================
# CDN and Caching
# ============================================

# CloudFlare
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Redis (for caching)
REDIS_URL=redis://localhost:6379

# ============================================
# Development Only
# ============================================

# Enable debug logging
DEBUG=true

# Bypass authentication (dev only!)
BYPASS_AUTH=false

# Mock external services
MOCK_EXTERNAL_SERVICES=false

# ============================================
# Testing
# ============================================

# Test database
TEST_DATABASE_URL=

# Test API keys (use sandbox/test keys)
TEST_STRIPE_KEY=

# ============================================
# CI/CD
# ============================================

# GitHub Actions
GITHUB_TOKEN=

# Deployment environments
DEPLOY_ENV=development
