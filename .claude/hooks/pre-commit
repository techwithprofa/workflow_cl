#!/bin/sh
# Pre-commit hook for code quality checks

echo "🔍 Running pre-commit checks..."

# Check if there are staged files
if git diff --cached --quiet; then
  echo "⚠️  No files staged for commit"
  exit 0
fi

# Run linter
echo "📝 Running linter..."
if command -v npm >/dev/null 2>&1; then
  if [ -f "package.json" ] && grep -q "\"lint\"" package.json; then
    npm run lint --silent
    if [ $? -ne 0 ]; then
      echo "❌ Linting failed. Please fix the errors before committing."
      echo "   Run 'npm run lint' to see all errors."
      exit 1
    fi
    echo "✅ Linting passed"
  fi
fi

# Run TypeScript type checking
echo "🔷 Checking TypeScript types..."
if [ -f "tsconfig.json" ]; then
  if command -v npx >/dev/null 2>&1; then
    npx tsc --noEmit --skipLibCheck
    if [ $? -ne 0 ]; then
      echo "❌ TypeScript type checking failed."
      echo "   Run 'npx tsc --noEmit' to see all errors."
      exit 1
    fi
    echo "✅ TypeScript types are valid"
  fi
fi

# Run Prettier
echo "💅 Checking code formatting..."
if command -v npm >/dev/null 2>&1; then
  if [ -f "package.json" ] && grep -q "\"format:check\"" package.json; then
    npm run format:check --silent
    if [ $? -ne 0 ]; then
      echo "⚠️  Code formatting issues detected."
      echo "   Run 'npm run format' to auto-fix."
      # Don't fail on format issues, just warn
    else
      echo "✅ Code formatting is good"
    fi
  fi
fi

# Check for common issues
echo "🔎 Checking for common issues..."

# Check for console.log statements
if git diff --cached --name-only | grep -E '\.(ts|tsx|js|jsx)$' >/dev/null; then
  CONSOLE_LOGS=$(git diff --cached --name-only | grep -E '\.(ts|tsx|js|jsx)$' | xargs grep -n 'console\.log' 2>/dev/null || true)
  if [ -n "$CONSOLE_LOGS" ]; then
    echo "⚠️  Found console.log statements:"
    echo "$CONSOLE_LOGS"
    echo "   Consider removing them before committing."
    # Don't fail, just warn
  fi
fi

# Check for TODO/FIXME comments
if git diff --cached --name-only | grep -E '\.(ts|tsx|js|jsx)$' >/dev/null; then
  TODOS=$(git diff --cached --name-only | grep -E '\.(ts|tsx|js|jsx)$' | xargs grep -n 'TODO\|FIXME' 2>/dev/null || true)
  if [ -n "$TODOS" ]; then
    echo "📝 Found TODO/FIXME comments:"
    echo "$TODOS"
    # Don't fail, just inform
  fi
fi

# Check for debugger statements
if git diff --cached --name-only | grep -E '\.(ts|tsx|js|jsx)$' >/dev/null; then
  DEBUGGERS=$(git diff --cached --name-only | grep -E '\.(ts|tsx|js|jsx)$' | xargs grep -n 'debugger' 2>/dev/null || true)
  if [ -n "$DEBUGGERS" ]; then
    echo "🐛 Found debugger statements:"
    echo "$DEBUGGERS"
    echo "❌ Please remove debugger statements before committing."
    exit 1
  fi
fi

# Check for merge conflict markers
if git diff --cached | grep -E '^(\+|-).*(<<<<<<<|=======|>>>>>>>)' >/dev/null; then
  echo "❌ Found merge conflict markers in staged files."
  echo "   Please resolve conflicts before committing."
  exit 1
fi

# Check for secrets (basic check)
if git diff --cached | grep -iE '(api_key|apikey|secret|password|token|credentials).*=.*["\'][^"\']{20,}["\']' >/dev/null; then
  echo "⚠️  Possible secrets detected in staged files."
  echo "   Please verify you're not committing sensitive data."
  echo "   Press Ctrl+C to abort, or Enter to continue."
  read -r
fi

echo "✅ Pre-commit checks passed!"
exit 0
