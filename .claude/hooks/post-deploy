#!/bin/sh
# Post-deploy hook to run after successful deployment

echo "🎉 Post-deployment tasks starting..."

# Get deployment info from environment or arguments
ENVIRONMENT="${DEPLOY_ENV:-production}"
DEPLOYED_AT=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
COMMIT_SHA=$(git rev-parse HEAD)
COMMIT_MSG=$(git log -1 --pretty=%B)
BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "detached")

echo "📋 Deployment Info:"
echo "   Environment: $ENVIRONMENT"
echo "   Branch: $BRANCH"
echo "   Commit: ${COMMIT_SHA:0:7}"
echo "   Time: $DEPLOYED_AT"

# Log deployment
echo "📝 Logging deployment..."
LOG_FILE="$HOME/.claude/deployment.log"
echo "$DEPLOYED_AT | $ENVIRONMENT | $BRANCH | ${COMMIT_SHA:0:7} | $COMMIT_MSG" >> "$LOG_FILE"

# Verify deployment
echo "🔍 Verifying deployment..."

# Health check (if URL is provided)
if [ -n "$DEPLOYMENT_URL" ]; then
  echo "   Checking $DEPLOYMENT_URL..."

  # Wait a few seconds for deployment to be ready
  sleep 5

  # Check if site is responding
  if command -v curl >/dev/null 2>&1; then
    response=$(curl -s -o /dev/null -w "%{http_code}" "$DEPLOYMENT_URL" || echo "000")

    if [ "$response" = "200" ]; then
      echo "   ✅ Site is live and responding"
    else
      echo "   ⚠️  Site returned status code: $response"
      echo "   Please check the deployment manually."
    fi
  else
    echo "   ⚠️  curl not found, skipping health check"
  fi
fi

# Notify team (example integrations)
echo "📢 Sending notifications..."

# Slack webhook (if configured)
if [ -n "$SLACK_WEBHOOK_URL" ]; then
  if command -v curl >/dev/null 2>&1; then
    curl -X POST -H 'Content-type: application/json' \
      --data "{
        \"text\": \"✅ Deployment to $ENVIRONMENT completed\",
        \"blocks\": [{
          \"type\": \"section\",
          \"text\": {
            \"type\": \"mrkdwn\",
            \"text\": \"*Deployment Successful* :rocket:\n*Environment:* $ENVIRONMENT\n*Branch:* $BRANCH\n*Commit:* \`${COMMIT_SHA:0:7}\`\n*Time:* $DEPLOYED_AT\"
          }
        }]
      }" \
      "$SLACK_WEBHOOK_URL" >/dev/null 2>&1

    if [ $? -eq 0 ]; then
      echo "   ✅ Slack notification sent"
    else
      echo "   ⚠️  Failed to send Slack notification"
    fi
  fi
fi

# Discord webhook (if configured)
if [ -n "$DISCORD_WEBHOOK_URL" ]; then
  if command -v curl >/dev/null 2>&1; then
    curl -X POST -H 'Content-type: application/json' \
      --data "{
        \"content\": \"✅ **Deployment to $ENVIRONMENT completed**\",
        \"embeds\": [{
          \"title\": \"Deployment Details\",
          \"fields\": [
            {\"name\": \"Environment\", \"value\": \"$ENVIRONMENT\", \"inline\": true},
            {\"name\": \"Branch\", \"value\": \"$BRANCH\", \"inline\": true},
            {\"name\": \"Commit\", \"value\": \"\`${COMMIT_SHA:0:7}\`\", \"inline\": true}
          ],
          \"color\": 5763719,
          \"timestamp\": \"$DEPLOYED_AT\"
        }]
      }" \
      "$DISCORD_WEBHOOK_URL" >/dev/null 2>&1

    if [ $? -eq 0 ]; then
      echo "   ✅ Discord notification sent"
    else
      echo "   ⚠️  Failed to send Discord notification"
    fi
  fi
fi

# Error tracking (mark release in Sentry)
if [ -n "$SENTRY_AUTH_TOKEN" ] && [ -n "$SENTRY_ORG" ] && [ -n "$SENTRY_PROJECT" ]; then
  if command -v curl >/dev/null 2>&1; then
    curl -X POST "https://sentry.io/api/0/organizations/$SENTRY_ORG/releases/" \
      -H "Authorization: Bearer $SENTRY_AUTH_TOKEN" \
      -H 'Content-Type: application/json' \
      -d "{
        \"version\": \"${COMMIT_SHA}\",
        \"projects\": [\"$SENTRY_PROJECT\"],
        \"dateReleased\": \"$DEPLOYED_AT\"
      }" >/dev/null 2>&1

    if [ $? -eq 0 ]; then
      echo "   ✅ Sentry release created"
    else
      echo "   ⚠️  Failed to create Sentry release"
    fi
  fi
fi

# Clear caches (if applicable)
if [ "$ENVIRONMENT" = "production" ]; then
  echo "🗑️  Clearing caches..."

  # CloudFlare cache purge (if configured)
  if [ -n "$CLOUDFLARE_API_TOKEN" ] && [ -n "$CLOUDFLARE_ZONE_ID" ]; then
    if command -v curl >/dev/null 2>&1; then
      curl -X POST "https://api.cloudflare.com/client/v4/zones/$CLOUDFLARE_ZONE_ID/purge_cache" \
        -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" \
        -H "Content-Type: application/json" \
        --data '{"purge_everything":true}' >/dev/null 2>&1

      if [ $? -eq 0 ]; then
        echo "   ✅ CloudFlare cache cleared"
      else
        echo "   ⚠️  Failed to clear CloudFlare cache"
      fi
    fi
  fi
fi

# Tag deployment in git
if [ "$ENVIRONMENT" = "production" ]; then
  echo "🏷️  Creating deployment tag..."
  TAG_NAME="deploy-$(date +%Y%m%d-%H%M%S)"
  git tag -a "$TAG_NAME" -m "Production deployment at $DEPLOYED_AT" 2>/dev/null

  if [ $? -eq 0 ]; then
    echo "   ✅ Created tag: $TAG_NAME"
  else
    echo "   ⚠️  Failed to create tag"
  fi
fi

# Generate deployment summary
echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "✅ Post-deployment tasks completed!"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "📊 Summary:"
echo "   Environment: $ENVIRONMENT"
echo "   Deployment: ${COMMIT_SHA:0:7}"
echo "   Time: $DEPLOYED_AT"
if [ -n "$DEPLOYMENT_URL" ]; then
  echo "   URL: $DEPLOYMENT_URL"
fi
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

exit 0
