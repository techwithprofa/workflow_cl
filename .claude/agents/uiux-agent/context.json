{
  "contextWindow": 150000,
  "maxTokens": 12288,
  "temperature": 0.7,
  "includeFiles": [
    "**/*.tsx",
    "**/*.jsx",
    "**/*.css",
    "**/*.scss",
    "**/*.module.css",
    "**/tailwind.config.*",
    "**/*.stories.*"
  ],
  "excludePatterns": [
    "node_modules/**",
    ".git/**",
    "dist/**",
    ".next/**"
  ]
}
