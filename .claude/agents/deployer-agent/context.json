{
  "contextWindow": 100000,
  "maxTokens": 4096,
  "temperature": 0.3,
  "includeFiles": [
    "**/vercel.json",
    "**/netlify.toml",
    "**/.github/workflows/**",
    "**/Dockerfile",
    "**/docker-compose.yml",
    "**/package.json",
    "**/.env.example"
  ],
  "excludePatterns": [
    "node_modules/**",
    ".git/**",
    "dist/**",
    ".env"
  ]
}
