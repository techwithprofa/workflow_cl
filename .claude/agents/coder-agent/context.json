{
  "contextWindow": 200000,
  "maxTokens": 16384,
  "temperature": 0.5,
  "includeFiles": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    "**/*.css",
    "**/*.json",
    "package.json",
    "tsconfig.json"
  ],
  "excludePatterns": [
    "node_modules/**",
    ".git/**",
    "dist/**",
    "build/**",
    ".next/**"
  ]
}
